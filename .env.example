# Postgres (Railway "db" service)
DATABASE_URL="postgresql://user:password@host:5432/forgecloud"

# Signs session cookies — generate with: openssl rand -base64 32
SESSION_SECRET=""

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# OVH Cloud Storage (S3-compatible object storage)
# Create a bucket + S3 credentials in the OVH Control Panel under
# Public Cloud > Object Storage, then set the region-matched endpoint,
# e.g. https://s3.gra.io.cloud.ovh.net for the Gravelines (GRA) region.
OVH_S3_ENDPOINT="https://s3.gra.io.cloud.ovh.net"
OVH_S3_REGION="gra"
OVH_S3_BUCKET="forgecloud-prod"
OVH_S3_ACCESS_KEY_ID=""
OVH_S3_SECRET_ACCESS_KEY=""

APP_URL="http://localhost:3000"
NODE_ENV="development"
